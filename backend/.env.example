# development | production  (production enables secure cookies, HSTS, hides /docs)
ENV=development

MONGODB_URL=mongodb://localhost:27017
DB_NAME=chatapp
# true = in-memory database for quick local demos (data is lost on restart)
USE_INMEMORY_DB=false

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-me-with-at-least-32-random-characters
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

# Comma-separated. Must include the frontend origin.
ALLOWED_ORIGINS=http://localhost:3000
# Set true only when running behind a reverse proxy you control
TRUST_PROXY=false

# These emails get the admin role (moderation dashboard) when they sign in
ADMIN_EMAILS=

# Optional: Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: AI conversation monitor (Claude). Leave empty to use pattern rules only.
ANTHROPIC_API_KEY=
MODERATION_MODEL=claude-opus-5-5
AI_MODERATION_INTERVAL_SECONDS=6

# CPU opponents: clearly-labelled practice bots that play people when nobody else is around.
# Free scripted brain by default; uses Claude (BOT_MODEL) only if ANTHROPIC_API_KEY is set.
BOTS_ENABLED=true
BOT_AFTER_SECONDS=12
BOT_MODEL=claude-opus-5-5
