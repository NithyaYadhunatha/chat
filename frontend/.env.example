# Public URL of this site (used for metadata, sitemap, robots).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where the FastAPI backend runs. Used server-side by the /api proxy.
BACKEND_URL=http://localhost:8000

# WebSocket endpoint the browser connects to directly. Must be wss:// in production.
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# Optional: enables "Continue with Google". Leave empty to hide it.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
